{
  "name": "@hyze/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply hyze-leads --local && wrangler dev",
    "check": "tsc",
    "test": "vitest run",
    "types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply hyze-leads --local",
    "db:migrate:remote": "wrangler d1 migrations apply hyze-leads --remote",
    "deploy": "wrangler deploy",
    "predev": "node scripts/dev-vars.mjs"
  },
  "description": "API de leads dos sites Hyze (api.hyzecompany.com.br) — Hono + D1 + Turnstile",
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3",
    "vitest": "~4.1.11",
    "wrangler": "^4.147.0"
  }
}
