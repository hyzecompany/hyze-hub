---
/**
 * Logo "Hyze." — wordmark do Figma (Poppins SemiBold).
 * `label` opcional identifica a subempresa (ex.: "sites"), mantendo a marca-mãe em destaque.
 */
interface Props {
  label?: string | undefined;
  tone?: "light" | "dark";
  size?: "sm" | "md" | "lg";
  href?: string | undefined;
  /** Anima o ponto final do logo na entrada (usado no hero). */
  animated?: boolean;
  class?: string;
}

const {
  label,
  tone = "light",
  size = "md",
  href = "/",
  animated = false,
  class: className,
} = Astro.props;

const sizes = {
  sm: "text-2xl",
  md: "text-3xl",
  lg: "text-6xl md:text-8xl",
} as const;

const color = tone === "light" ? "text-platinum" : "text-navy-950";
const labelColor = tone === "light" ? "text-navy-400" : "text-navy-700";
---

<a
  href={href}
  class:list={["group inline-flex items-baseline gap-2 leading-none no-underline", className]}
  aria-label={label ? `Hyze ${label} — página inicial` : "Hyze — página inicial"}
>
  <span class:list={["font-semibold tracking-tight", sizes[size], color]}>
    Hyze
    <span class="inline-block" data-logo-dot={animated ? "" : undefined}>
      .
    </span>
  </span>
  {label && <span class:list={["text-base font-extralight lowercase", labelColor]}>{label}</span>}
</a>
